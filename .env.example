# Skopiuj do .env (plik .env jest w .gitignore). Klucze zna tylko gateway, nigdy agent.

# Model docelowy: OpenAI. Bez klucza używaj --model stub-model.
OPENAI_API_KEY=

# System One: Jev (TypeSafe AI). Bez klucza gateway sam przełącza się na stub.
TYPESAFE_API_KEY=

# Opcjonalnie: wymuś backend System One niezależnie od polityki (jev | stub | off).
# SPIRE_SYSTEMONE_BACKEND=stub
